# datasets and derived volumes: never commit (size + licenses)
/data/*
!/data/scripts/
*.nii
*.nii.gz
*.dcm
*.zip

# training outputs
checkpoints/
runs/
*.ckpt

# python / jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
*.egg-info/

# videos: generated/derived content stays local
videos/node_modules/
videos/out/
videos/.venv/
